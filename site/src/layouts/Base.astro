---
import '@fontsource/noto-sans-thai-looped/400.css';
import '@fontsource/noto-sans-thai-looped/600.css';
import '@fontsource/anuphan/600.css';
import '@fontsource/anuphan/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { PREVIEW } from '../lib/directus.js';
import { getSite, href, plain, safeLink, telHref } from '../lib/site.js';

interface Props {
	title?: string;
	description?: string;
	image?: string | null;
	type?: 'website' | 'article';
	current?: string;
	noindex?: boolean;
}
const { title, description, image, type = 'website', current, noindex } = Astro.props;
const { settings, name, nav } = await getSite();
const fullTitle = title ? `${title} | ${name}` : name;
const desc = description || `เว็บไซต์${name} ข่าวประชาสัมพันธ์ บริการ และข้อมูลสำหรับผู้ป่วย`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const announcement = plain(settings.announcement);
const emergency = settings.emergency_phone || '1669';
const phoneHref = telHref(settings.phone);
const facebook = safeLink(settings.facebook_url);
const line = safeLink(settings.line_url);
const year = new Date().getFullYear() + 543;
const footerLinks = nav.filter((n) => n.href && n.href !== href(''));
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={desc} />
		{noindex || PREVIEW ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical.href} />}
		<meta property="og:site_name" content={name} />
		<meta property="og:title" content={title ?? name} />
		<meta property="og:description" content={desc} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:locale" content="th_TH" />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="theme-color" content="#1E2B63" />
		<link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">ข้ามไปเนื้อหา</a>
		{PREVIEW && <div class="preview-bar" data-pagefind-ignore>ตัวอย่างเว็บสำหรับเจ้าหน้าที่ แสดงฉบับร่างด้วย (หน้าเว็บจริงจะไม่แสดงฉบับร่าง) อัปเดตอัตโนมัติภายใน 1 นาทีหลังบันทึก</div>}
		{
			announcement && (
				<div class="alert" role="note" data-pagefind-ignore>
					<div class="wrap">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
						</svg>
						<span>
							<strong>แจ้งเตือน:</strong> {announcement}
						</span>
					</div>
				</div>
			)
		}
		<header class="site-header" data-pagefind-ignore>
			<div class="wrap">
				<a class="brand" href={href('')}>
					<span class="brand-mark">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"></path></svg>
					</span>
					<span class="brand-text">
						<span class="brand-name">{name}</span>
						<span class="brand-sub">Waritchaphum Hospital จังหวัดสกลนคร</span>
					</span>
				</a>
				<Nav nav={nav} current={current} class="nav-desktop" />
				<div class="actions">
					<a class="icon-btn" href={href('search/')} aria-label="ค้นหา">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
					</a>
					<a class="btn-emergency" href={telHref(emergency)}>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
						</svg>
						ฉุกเฉิน {emergency}
					</a>
				</div>
				<details class="menu-toggle">
					<summary>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
						เมนู
					</summary>
					<Nav nav={nav} current={current} />
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer" data-pagefind-ignore>
			<div class="wrap footer-cols">
				<div>
					<span class="footer-name">{name}</span>
					{settings.address && <span class="address">{plain(settings.address)}</span>}
					<span>
						{settings.phone && phoneHref && (
							<>
								โทร <a href={phoneHref}>{settings.phone}</a>
								<br />
							</>
						)}
						ฉุกเฉิน <a href={telHref(emergency)}>{emergency}</a> ตลอด 24 ชั่วโมง
					</span>
				</div>
				<nav aria-label="ลิงก์ท้ายเว็บ">
					{footerLinks.map((n) => <a href={n.href}>{n.label}</a>)}
					<a href={href('news/category/procurement/')}>ประกาศจัดซื้อจัดจ้าง</a>
				</nav>
				{
					(facebook || line) && (
						<div>
							{facebook && (
								<a href={facebook} rel="noopener noreferrer" target="_blank">
									Facebook
								</a>
							)}
							{line && (
								<a href={line} rel="noopener noreferrer" target="_blank">
									LINE OA
								</a>
							)}
						</div>
					)
				}
			</div>
			<div class="wrap footer-copy">© {year} {name}</div>
		</footer>
	</body>
</html>
