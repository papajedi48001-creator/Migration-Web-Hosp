---
// การ์ดข่าวในหน้ารวมข่าว
interface Props {
	n: Awaited<ReturnType<typeof import('../lib/news.js').card>>;
}
const { n } = Astro.props;
---

<a class="card" href={n.href}>
	{n.img ? <span class="zoom"><img class="cover" src={n.img} alt="" loading="lazy" decoding="async" width="600" height="400" /></span> : <div class="ph" aria-hidden="true" />}
	<span class="meta">
		{n.draft && <span class="badge badge-pin">ฉบับร่าง</span>}
		{n.pinned && <span class="badge badge-pin">ปักหมุด</span>}
		<span class="news-cat">{n.cat}</span>
		{n.date && <time datetime={n.iso}>{n.date}</time>}
	</span>
	<span class="news-title">{n.title}</span>
	{n.summary && <p>{n.summary}</p>}
</a>
