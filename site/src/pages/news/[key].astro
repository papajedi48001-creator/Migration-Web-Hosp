---
// หน้าข่าว /news/<slug หรือ id>/
import Attachments from '../../components/Attachments.astro';
import Share from '../../components/Share.astro';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, getNews, newsKey, thaiDate } from '../../lib/directus.js';
import { mediaUrl, renderBody } from '../../lib/media.js';
import { card, catHref } from '../../lib/news.js';
import { href, plain } from '../../lib/site.js';

export async function getStaticPaths() {
	return (await getNews()).map((n) => ({ params: { key: newsKey(n) }, props: { id: n.id } }));
}

const all = await getNews();
const n = all.find((x) => x.id === Astro.props.id);
const cover = n.cover ? await mediaUrl(n.cover, 'content') : null;
const body = await renderBody(n.body);
const cat = CATEGORIES[n.category];
const latest = await Promise.all(
	all
		.filter((x) => x.id !== n.id)
		.slice(0, 5)
		.map((x) => card(x)),
);
const url = new URL(Astro.url.pathname, Astro.site).href;
const summary = plain(n.summary) || plain(n.body).replace(/\s+/g, ' ').slice(0, 160);
---

<Base title={n.title} description={summary} image={cover} type="article" current={href('news/')}>
	<Fragment slot="head">
		{n.date && <meta property="article:published_time" content={new Date(n.date).toISOString()} />}
	</Fragment>
	<div class="wrap page-main">
		<nav class="crumbs" aria-label="ตำแหน่งหน้า">
			<ol>
				<li><a href={href('')}>หน้าแรก</a></li>
				<li><a href={href('news/')}>ข่าวสาร</a></li>
				{cat && <li><a href={catHref(n.category)}>{cat}</a></li>}
			</ol>
		</nav>
		<div class="article-layout">
			<article class="article" data-pagefind-body>
				<div class="meta">
					{n.status !== 'published' && <span class="badge badge-pin">ฉบับร่าง</span>}
					{cat && <span class="badge" data-pagefind-filter="หมวด">{cat}</span>}
					{n.date && <time datetime={new Date(n.date).toISOString()} data-pagefind-meta="date">{thaiDate(n.date)}</time>}
				</div>
				<h1>{n.title}</h1>
				{cover && <img class="cover" src={cover} alt="" data-pagefind-meta="image[src]" />}
				<div class="prose" set:html={body} />
				<Attachments files={n.files} />
				<Share url={url} />
			</article>
			<aside class="aside" aria-labelledby="h-latest" data-pagefind-ignore>
				<h2 id="h-latest">ข่าวล่าสุด</h2>
				{
					latest.map((x) => (
						<a class="aside-item" href={x.href}>
							<span class="news-cat">{x.cat}</span>
							<span class="news-title">{x.title}</span>
							{x.date && <time class="news-date" datetime={x.iso}>{x.date}</time>}
						</a>
					))
				}
				<a class="more" href={href('news/')}>ดูข่าวทั้งหมด →</a>
			</aside>
		</div>
	</div>
</Base>
