# คัดลอกเป็น .env แล้วรัน scripts/gen-secrets.sh เพื่อสุ่มรหัสลับ
# ห้าม commit ไฟล์ .env ขึ้น git (อยู่ใน .gitignore แล้ว)

# URL ที่เจ้าหน้าที่ใช้เข้าหลังบ้าน (เข้าได้จากในโรงพยาบาลเท่านั้น)
PUBLIC_URL=https://waritch-hosp.moph.go.th:8443
DIRECTUS_PORT=8055

DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=
DIRECTUS_KEY=
DIRECTUS_SECRET=

# ใช้ครั้งแรกครั้งเดียวตอนสร้าง admin คนแรก (admin01) แล้วลบสองบรรทัดนี้ทิ้ง
# Directus ใช้อีเมลเป็นชื่อผู้ใช้ จึงตั้งเป็น admin01@... (ไม่ต้องเป็นอีเมลที่มีอยู่จริง)
ADMIN_EMAIL=admin01@waritch-hosp.moph.go.th
ADMIN_PASSWORD=

# วง IP ของเครื่องในโรงพยาบาลที่เข้าหลังบ้าน :8443 ได้ (firewalld) คั่นด้วยช่องว่าง
ADMIN_LAN_CIDRS="192.168.0.0/16 172.18.0.0/16"
# วง IP ภายใน Docker ของระบบนี้ ต้องไม่ซ้ำกับวงใดที่ใช้ในโรงพยาบาล
HOSPWEB_NET_BACKEND=10.250.230.0/24
HOSPWEB_NET_EGRESS=10.250.231.0/24

# หน้าเว็บ static (scripts/build-site.sh)
# token ของบัญชี "ระบบ build เว็บ" (อ่านอย่างเดียว) bootstrap พิมพ์ให้ครั้งเดียวตอนสร้าง
DIRECTUS_READ_TOKEN=
SITE_URL=https://waritch-hosp.moph.go.th
# โฟลเดอร์ที่ nginx เสิร์ฟ: $SITE_ROOT/site/current และ $SITE_ROOT/preview/current
SITE_ROOT=/srv/hospweb

# อีเมลสำหรับลืมรหัสผ่าน (ไม่บังคับ)
EMAIL_FROM=no-reply@waritch-hosp.moph.go.th
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# ที่เก็บ backup และจำนวนวันที่เก็บ
BACKUP_DIR=/srv/backup/hospweb
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# rsync backup ไปเก็บที่ NAS (.241) ผ่าน ssh key ดู docs/plan.md หัวข้อ 8
BACKUP_OFFSITE=hospweb-backup@192.168.1.241:/volume1/backup/hospweb
